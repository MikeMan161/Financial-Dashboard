# cp .env.example .env, then fill in real values. Never commit the real .env.

DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/financial_dashboard

# Auth. Generate a secret with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated, no spaces. Must exactly match the frontend origin,
# scheme and port included, or requests fail as browser CORS errors.
CORS_ORIGINS=http://localhost:5173

# Read directly from the environment by the Anthropic SDK, so it appears
# nowhere in the code. Only the AI routes fail if it is missing.
ANTHROPIC_API_KEY=sk-ant-replace-me
